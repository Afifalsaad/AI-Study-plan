generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  email     String   @unique
  name      String?
  password  String?
  updatedAt DateTime @default(now()) @updatedAt
  image     String?
  provider  String?

  studyPlans StudyPlan[]
}

model Summary {
  id          Int      @id @default(autoincrement())
  userId      Int?
  title       String
  createdAt   DateTime @default(now())
  fileName    String
  fileSize    String
  summaryText String
}

model StudyPlan {
  id        String   @id @default(cuid())
  userId    Int
  examName  String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
