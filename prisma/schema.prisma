datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String?
  email     String   @unique
  image     String?   
  password     String?
  provider     String?
  updatedAt     DateTime @default(now())  @updatedAt
}

model Summary {
  id             Int   @id @default(autoincrement())
  userId         Int?
  title          String
  fileName       String
  fileSize       String
  summaryPreview String?
  summaryText    String   @db.Text
  createdAt      DateTime @default(now())
}